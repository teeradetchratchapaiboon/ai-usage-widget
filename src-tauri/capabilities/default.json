{
  "identifier": "default",
  "description": "Capabilities for the AI Usage Widget widget and dashboard windows",
  "windows": [
    "main",
    "dashboard"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/teeradetchratchapaiboon/ai-usage-widget/*"
        }
      ]
    }
  ]
}
